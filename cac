 [/Prepare for a Specific Opponent/i, "Từ các ván công khai có sẵn của đối thủ giả định, ghi xu hướng khai cuộc và tạo kế hoạch B; không dựa vào mẫu quá nhỏ để kết luận chắc chắn."],
 [/Tournament Decisions Under Time Pressure/i, "Phân tích 3 vị trí khó và đặt ngân sách thời gian cho mỗi vị trí; nêu nước đi nào cần tính sâu và vị trí nào có thể chơi theo nguyên tắc."],
 [/Self-Analysis/i, "Phân loại 5 lỗi thành kiến thức, tính toán, chiến lược, khai cuộc, tàn cuộc hoặc thời gian; chọn một lỗi lặp lại để lập bài luyện riêng."],
 [/Mastery Capstone/i, "Chú giải một ván nghiêm túc: ứng viên ở các vị trí then chốt, biến chính, ý tưởng chiến lược, sai lầm và một bài học luyện tập từ ván đó."]
];
function customDrillFor(l){const entry=customDrills.find(([re])=>re.test(l.title));return entry?entry[1]:null;}
function missionFor(l){
 const level=levelOf(l.level), title=l.title, dest=practiceDestination(l);
 const puzzleTarget={newbie:3,beginner:5,intermediate:7,advanced:8,master:10}[l.level]||5;
 const custom=customDrillFor(l);
 let objective;
 if(l.category==="Tactics") objective=`Nhận ra và thực hiện đúng motif “${l.skill}” trong ${title.toLowerCase()} mà không dựa vào đoán mò.`;
 else if(l.category==="Opening") objective=`Hiểu ý tưởng, kế hoạch và cấu trúc của “${title}”, không chỉ học thuộc chuỗi nước.`;
 else if(l.category==="Strategy") objective=`Từ một vị trí thực tế, đánh giá kế hoạch và xác định vì sao “${l.skill}” phù hợp hơn những lựa chọn khác.`;
 else if(l.category==="Calculation") objective=`Tìm nước ứng viên, tính phản ứng tốt nhất của đối thủ và đánh giá vị trí cuối trong chủ đề “${title}”.`;
 else if(l.category==="Endgame") objective=`Biết cách thiết lập và thực hiện kỹ thuật “${title}”, đồng thời phân biệt thế thắng với thế hòa.`;
 else if(l.category==="Analysis") objective=`Tự phân tích trước khi dùng engine và biến bài học “${title}” thành một ghi chú có thể áp dụng trong ván sau.`;
 else if(l.category==="Practical") objective=`Dùng “${title}” như một thói quen trong ván thật, rồi kiểm tra bằng cách xem lại quyết định.`;
 else objective=`Nắm được “${title}” đến mức có thể giải thích, thực hiện và nhận ra nó trong vị trí mới.`;
 const task1={title:"Học chủ động — không xem thụ động",text:`Xem video bài “${title}”. Tạm dừng sau ví dụ chính; ghi lại bằng lời của bạn: quy tắc/ý tưởng là gì, dấu hiệu nào cho biết nên dùng, và một lỗi dễ mắc. Không cần chép nguyên lời giảng.`};
 let task2;
 if(l.category==="Tactics") task2={title:`Drill mục tiêu: ${l.skill}`,text:custom||`Giải ${puzzleTarget} puzzle chủ đề phù hợp trên Lichess. Trước khi đi, nêu mục tiêu của đòn, nước phản ứng mạnh nhất của đối thủ và điều gì bạn thu được. Mục tiêu: ít nhất ${Math.max(2,puzzleTarget-1)}/${puzzleTarget} bài đúng, không dùng gợi ý.`};
 else if(l.category==="Opening") task2={title:"Dựng một mini-repertoire",text:custom||`Trên Opening Explorer hoặc bàn phân tích, dựng một nhánh liên quan tới “${title}” trong 8–12 nửa nước. Ghi ý tưởng của từng bên, cấu trúc tốt và một phương án đối thủ đi lệch. Mục tiêu: giải thích kế hoạch chứ không chỉ đọc nước.`};
 else if(l.category==="Endgame") task2={title:"Làm bài tập tàn cuộc",text:custom||`Mở Lichess Practice, chọn bài gần với “${title}” và làm ít nhất ${Math.max(3,Math.ceil(puzzleTarget/2))} vị trí. Tự đi trước khi xem gợi ý; ở mỗi vị trí hãy xác định bên nào thắng/hòa và mục tiêu của vua/xe/tốt.`};
 else if(l.category==="Strategy") task2={title:"Phân tích kế hoạch từ vị trí",text:custom||`Mở một ván đã chơi hoặc một ván mẫu trên bàn phân tích. Tìm 3 vị trí mà “${l.skill}” có liên quan; liệt kê 2 kế hoạch ứng viên, nước cải thiện quân kém nhất và kế hoạch đối thủ cần ngăn. Chỉ bật engine sau khi đã ghi ý tưởng.`};
 else if(l.category==="Calculation") task2={title:"Tính biến trước khi di chuyển quân",text:custom||`Ở ${puzzleTarget} vị trí phù hợp, ghi ít nhất 2 nước ứng viên rồi tính phản ứng mạnh nhất của đối thủ trong 2–4 ply. Đánh giá vị trí kết thúc theo vật chất, an toàn vua và hoạt động quân. Chỉ sau đó mới kiểm tra bằng engine.`};
 else if(l.category==="Analysis") task2={title:"Tạo bản phân tích của riêng bạn",text:custom||`Chọn một ván của bạn hoặc ván mẫu; ghi chú 3 vị trí quan trọng liên quan đến “${title}” trước khi bật engine. Sau đó kiểm tra lại và ghi rõ điều engine làm bạn thay đổi suy nghĩ.`};
 else if(l.category==="Practical") task2={title:"Thực hành có mục tiêu",text:custom||`Chơi một ván rapid ít nhất 10+5 và áp dụng “${title}” có ý thức. Sau ván, tìm 3 quyết định quan trọng; ghi quyết định nào đúng, quyết định nào cần xem lại và vì sao.`};
 else task2={title:"Bài tập thao tác",text:custom||`Mở Lichess Learn hoặc bàn phân tích và thực hiện ${puzzleTarget} lượt luyện về “${title}”. Với từng lượt, dự đoán kết quả trước khi thao tác rồi tự giải thích vì sao cách làm đúng. Nếu sai, làm lại cho đến khi nêu được quy tắc.`};
 let task3;
 if(l.category==="Opening") task3={title:"Chuyển vào ván thật",text:"Chơi 2 ván rapid, thử áp dụng đúng kế hoạch đã ghi. Sau mỗi ván, đánh dấu nước đầu tiên mà đối thủ đi khác nhánh và giải thích cách bạn xử lý theo nguyên tắc."};
 else if(l.category==="Endgame") task3={title:"Kiểm tra nhớ lại sau 24 giờ",text:"Không mở lại video, dựng lại một thế tương tự và thực hiện kỹ thuật từ trí nhớ. Ghi một điều kiện thắng, một điều kiện hòa và một sai lầm có thể làm hỏng thế cờ."};
 else if(l.category==="Analysis") task3={title:"Ghi lại bài học có thể tái sử dụng",text:"Viết một ghi chú ngắn gồm: dấu hiệu nhận biết lỗi, quy tắc tránh lỗi và bài tập sẽ làm nếu lỗi này xuất hiện lại. Gắn ghi chú với nước đi hoặc vị trí cụ thể."};
 else if(l.category==="Calculation") task3={title:"Mang quy trình vào rapid",text:"Trong một ván rapid, dừng ở ít nhất 3 vị trí then chốt để tìm ứng viên và tính phản ứng tốt nhất của đối thủ. Sau ván, kiểm tra xem bạn bỏ sót nước chiếu, bắt quân hoặc đe dọa nào không."};
 else if(l.category==="Practical") task3={title:"Đánh giá hiệu quả",text:"Sau ván, ghi một lần bạn đã sử dụng kỹ năng này và một lần bạn quên sử dụng. Viết một quy tắc nhắc nhở thật ngắn để dùng ở ván tiếp theo."};
 else if(l.category==="Tactics") task3={title:"Kiểm tra trong ván thật",text:"Chơi một ván rapid. Sau ván, xem lại ít nhất 3 vị trí có đòn bắt quân hoặc đe dọa; tìm xem có cơ hội áp dụng hay phòng thủ motif này không. Nếu không có cơ hội, ghi vị trí minh họa từ bài luyện."};
 else task3={title:"Kiểm tra chuyển giao",text:"Chơi một ván rapid và áp dụng bài học ở ít nhất một quyết định. Sau ván, lưu lại vị trí đó hoặc viết 3 câu: tình huống, nước đã chọn, và nước bạn sẽ cân nhắc sau khi học."};
 const winCondition=l.category==="Tactics"?(custom?"Hoàn thành bài tập cụ thể ở nhiệm vụ 2; với từng vị trí, giải thích được mục tiêu chiến thuật, phản ứng tốt nhất của đối thủ và kết quả cuối.":`Đạt ít nhất ${Math.max(2,puzzleTarget-1)}/${puzzleTarget} puzzle đúng và giải thích được ý tưởng lẫn phản ứng phòng thủ.`):l.category==="Opening"?"Tự giải thích kế hoạch của cả hai bên ở một nhánh và xử lý được một nước đi khác với nhánh đã học.":l.category==="Endgame"?"Thực hiện đúng kỹ thuật ở ít nhất 3 vị trí và giải thích được điều kiện thắng/hòa.":l.category==="Analysis"?"Có ít nhất 3 ghi chú vị trí cụ thể, trong đó phân biệt rõ suy nghĩ ban đầu với kết quả kiểm chứng.":"Hoàn thành cả 3 nhiệm vụ, giải thích lại ý tưởng bằng lời của bạn và chỉ ra một ví dụ áp dụng cụ thể.";
 return {objective,tasks:[task1,task2,task3],dest,winCondition,puzzleTarget};
}
function openLesson(id){
 const l=LESSONS.find(x=>x.id===id); if(!l)return;
 activeLessonId=id;
 const m=missionFor(l), lev=levelOf(l.level), pal=paletteByLevel[l.level][(l.global-1)%3];
 const checks=Array.isArray(taskChecks[id])?taskChecks[id]:[false,false,false];
 const done=completed.has(id);
 const codes=piecesByCategory[l.category]||["wN","bQ","wP"];
 document.getElementById('lessonModalContent').innerHTML=`
 <div class="mission-hero" style="--c1:${pal[0]};--c2:${pal[1]}">
  <div><div class="mission-kicker">${lev.name.toUpperCase()} · LESSON ${String(l.number).padStart(2,'0')} · ${l.category.toUpperCase()}</div><h2 class="mission-title" id="missionTitle">${esc(l.title)}</h2><p class="mission-desc">${esc(m.objective)}</p></div>
  <div class="mission-piece-card">${pieceImg(codes[(l.global)%codes.length]||'wN','',l.title+ ' piece')}</div>
 </div>
 <div class="mission-layout">
  <section class="mission-panel"><h3>Learning mission</h3><p class="mission-muted">Xem video là bước đầu. Tick từng nhiệm vụ sau khi bạn thực sự làm xong; hoàn thành đủ 3 bước để ghi nhận lesson.</p>
   <div class="mission-task-list">${m.tasks.map((t,i)=>`<div class="mission-task"><input class="mission-task-check" type="checkbox" id="task-${id}-${i}" data-task-index="${i}" ${checks[i]?'checked':''}><label for="task-${id}-${i}"><strong>${i+1}. ${esc(t.title)}</strong><span>${esc(t.text)}</span></label></div>`).join('')}</div>
   <div class="mission-progress-row"><span>Tiến độ nhiệm vụ</span><strong id="missionProgressText">${checks.filter(Boolean).length}/3</strong></div><div class="mission-progress-track"><span id="missionProgressBar" style="width:${checks.filter(Boolean).length/3*100}%"></span></div>
   <button class="mission-finish" id="finishMission" ${checks.filter(Boolean).length===3?'':'disabled'}>${done?'✓ Lesson đã hoàn thành':'Đánh dấu hoàn thành lesson'}</button>
   <p class="mission-finish-note" id="finishMissionNote">${checks.filter(Boolean).length===3?'Đã đủ 3 nhiệm vụ — bạn có thể lưu tiến độ.':'Hoàn thành đủ 3 nhiệm vụ để mở nút hoàn thành.'}</p>
   <div class="mission-complete-banner ${done?'show':''}" id="missionCompleteBanner">✓ Bài này đã được lưu là hoàn thành. Bạn có thể xem lại nhiệm vụ để củng cố kiến thức.</div>
  </section>
  <aside class="mission-panel"><h3>Video & nơi luyện tập</h3><p class="mission-muted">Mở video trước, sau đó luyện trên bàn cờ thật. Link thực hành được chọn theo chủ đề của bài.</p>
   <a class="mission-link" href="${esc(yUrl(l))}" target="_blank" rel="noopener"><span>${l.videoUrl?'▶ Xem video đã chọn':'▶ Tìm video YouTube cho lesson'}<small>${l.videoUrl?'Video cụ thể được gắn trong curriculum':'Mở kết quả tìm kiếm theo tiêu đề và level'}</small></span><b>↗</b></a>
   <a class="mission-link" href="${esc(m.dest.url)}" target="_blank" rel="noopener"><span>${esc(m.dest.name)}<small>${esc(m.dest.detail)}</small></span><b>↗</b></a>
   <a class="mission-link" href="https://lichess.org/analysis" target="_blank" rel="noopener"><span>Mở bàn phân tích Lichess<small>Tạo vị trí, thử biến và kiểm tra cách tính</small></span><b>↗</b></a>
   <div class="mission-standard"><strong>Tiêu chí để tự kiểm tra</strong>${esc(m.winCondition)}</div>
   <div class="mission-standard"><strong>Quy tắc học</strong>Không đánh dấu hoàn thành chỉ vì đã xem video. Hãy tick sau khi thực hiện được nhiệm vụ và giải thích được vì sao cách làm đúng.</div>
  </aside>
 </div>`;
 const modal=document.getElementById('lessonModal'); modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden';
 document.getElementById('closeLessonModal').focus();
 document.querySelectorAll('.mission-task-check').forEach(box=>box.addEventListener('change',()=>{
   const arr=Array.isArray(taskChecks[id])?taskChecks[id]:[false,false,false];
   arr[Number(box.dataset.taskIndex)]=box.checked; taskChecks[id]=arr;
   try{localStorage.setItem('knightAcademyTaskChecks',JSON.stringify(taskChecks));}catch(e){}
   updateMissionProgress(); renderLevels(); renderLessons();
 }));
 document.getElementById('finishMission').addEventListener('click',()=>{
   const checksNow=taskChecks[id]||[];
   if(checksNow.filter(Boolean).length<3)return;
   completed.add(id); try{localStorage.setItem('knightAcademyCompleted',JSON.stringify([...completed]));}catch(e){}
   renderLevels();renderLessons();updateProgress();
   document.getElementById('finishMission').textContent='✓ Lesson đã hoàn thành';
   document.getElementById('finishMissionNote').textContent='Tiến độ đã được lưu trong trình duyệt.';
   document.getElementById('missionCompleteBanner').classList.add('show');
   showToast('Đã hoàn thành lesson '+String(l.global).padStart(3,'0')+' — '+l.title);
 });
}
function updateMissionProgress(){
 if(!activeLessonId)return;
 const n=(taskChecks[activeLessonId]||[]).filter(Boolean).length;
 const text=document.getElementById('missionProgressText'), bar=document.getElementById('missionProgressBar'), button=document.getElementById('finishMission'), note=document.getElementById('finishMissionNote');
 if(text)text.textContent=`${n}/3`; if(bar)bar.style.width=`${n/3*100}%`;
 if(button){button.disabled=n!==3;button.textContent=completed.has(activeLessonId)?'✓ Lesson đã hoàn thành':'Đánh dấu hoàn thành lesson';}
 if(note)note.textContent=n===3?'Đã đủ 3 nhiệm vụ — bạn có thể lưu tiến độ.':`Còn ${3-n} nhiệm vụ cần làm trước khi hoàn thành.`;
}
function closeLesson(){const modal=document.getElementById('lessonModal');modal.classList.remove('open');modal.setAttribute('aria-hidden','true');document.body.style.overflow='';activeLessonId=null;}
document.getElementById('closeLessonModal').addEventListener('click',closeLesson);
document.getElementById('lessonModal').addEventListener('click',e=>{if(e.target.id==='lessonModal')closeLesson();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('lessonModal').classList.contains('open'))closeLesson();});

function updateProgress(){const n=completed.size;document.getElementById('headerProgress').textContent=`${n} / ${LESSONS.length}`;document.getElementById('bigProgress').textContent=`${n} / ${LESSONS.length}`;}
let toastTimer;function showToast(message){const el=document.getElementById('toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2100);}
function resetFilters(){selectedLevel='all';selectedCategory='All topics';query='';sortMode='sequence';document.getElementById('searchInput').value='';document.getElementById('levelSelect').value='all';document.getElementById('sortSelect').value='sequence';renderLevels();renderChips();renderLessons();}
document.getElementById('searchInput').addEventListener('input',e=>{query=e.target.value;renderLessons();});
document.getElementById('levelSelect').addEventListener('change',e=>{selectedLevel=e.target.value;renderLevels();renderLessons();});
document.getElementById('sortSelect').addEventListener('change',e=>{sortMode=e.target.value;renderLessons();});
document.getElementById('resetFilters').addEventListener('click',resetFilters);
document.getElementById('menuToggle').addEventListener('click',()=>document.getElementById('navLinks').classList.toggle('open'));
document.querySelectorAll('#navLinks a').forEach(a=>a.addEventListener('click',()=>document.getElementById('navLinks').classList.remove('open')));
document.getElementById('scrollTop').addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
window.addEventListener('scroll',()=>document.getElementById('scrollTop').classList.toggle('visible',window.scrollY>650),{passive:true});
document.getElementById('yearNow').textContent=new Date().getFullYear();
makeHeroBoard();renderSelects();renderChips();renderLevels();renderLessons();updateProgress();
</script>
</body></html>
