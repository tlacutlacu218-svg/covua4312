 const words=l.title.split(' '); let line1=esc(l.title);
 if(l.title.length>25){let best=0,delta=999;for(let i=1;i<words.length;i++){const d=Math.abs(words.slice(0,i).join(' ').length-words.slice(i).join(' ').length);if(d<delta){delta=d;best=i;}}if(best>0)line1=esc(words.slice(0,best).join(' '))+'<br>'+esc(words.slice(best).join(' '));}
 const level=levelOf(l.level);
 return `<div class="lesson-thumb" style="--c1:${pal[0]};--c2:${pal[1]};--lev:${level.color}"><div class="thumb-copy"><span class="thumb-level">${level.name.toUpperCase()} · LESSON ${String(l.number).padStart(2,'0')}</span><strong>${line1}</strong></div><div class="thumb-art"><div class="thumb-board"></div>${pieceImg(main,"thumb-piece",l.title+" chess piece")}${pieceImg(secondary,"thumb-small",l.category+" chess piece")}</div><span class="thumb-index">${String(l.global).padStart(3,'0')}</span></div>`;
}
